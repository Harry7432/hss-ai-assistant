# ==========================================
# HSS AI Assistant - Variáveis de Ambiente
# ==========================================

# OpenAI API Configuration
OPENAI_API_KEY=sua_chave_openai_aqui
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Chunking & Ingestion Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DOCUMENTS_DIRECTORY=base

# Vector Store & Retrieval Parameters
CHROMA_PERSIST_DIRECTORY=db
RETRIEVAL_K=4
RELEVANCE_THRESHOLD=0.35
MAX_PRUNE_PERCENTAGE=20

# Observability & LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=sua_chave_langsmith_aqui
LANGCHAIN_PROJECT=hss-ai-assistant
LOG_LEVEL=INFO
